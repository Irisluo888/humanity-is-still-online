  "outcome_flags": {
    "ch01_store_owner_saved": "bool",
    "ch01_lunch_yes": "bool",
    "ch01_zhou_outcome": [
      "quarantine",
      "colleague_help",
      "aid_pending",
      "missing",
      "opened_door"
    ],
    "ch01_told_group": "bool",
    "ch01_high_risk_exposure": "bool"
  },
  "conditional_invariants": [
    "ch01_store_attack requires ch01_elevator_done",
    "ch01_elevator requires ch01_1203_done, not ch01_1404_seen",
    "ch01_knock_reveal only after the phone sound cue",
    "ch01_zhou_final only after reveal",
    "normal_encounters never set ch01_high_risk_exposure",
    "fast_home unavailable while danger event active",
    "no repeat event effect after reload"
  ]
